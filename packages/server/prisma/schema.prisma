generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum TeamMembershipRole {
  VIEWER
  EDITOR
  OWNER
}

enum WorkflowStateType {
  BACKLOG
  UNSTARTED
  STARTED
  REVIEW
  COMPLETED
  CANCELED
}

enum ActorKind {
  HUMAN
  AGENT
  SERVICE
}

enum WorkKind {
  ISSUE
  PROJECT
  MILESTONE
  DECISION
  EPIC
}

enum CommitmentStatus {
  CANDIDATE
  COMMITTED
  REJECTED
}

enum WorkLinkType {
  CONTAINS
  BLOCKS
  DERIVED_FROM
  DISCOVERED_DURING
  RELATED_TO
  DUPLICATE_OF
}

enum WorkRunStatus {
  QUEUED
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
}

// Borrowed verbatim from A2A's task lifecycle rather than invented here. The
// wire spellings are A2A's (`submitted`, `working`, `input-required`,
// `completed`, `failed`, `canceled`); these identifiers are the same names in
// the spelling Prisma enums allow, mapped in agent-request-state.ts.
enum AgentRequestState {
  SUBMITTED
  WORKING
  INPUT_REQUIRED
  COMPLETED
  FAILED
  CANCELED
}

enum WorkEvidenceKind {
  PR
  TEST
  LOG
  SCREENSHOT
  ARTIFACT
  DECISION
}

enum WorkReviewDecisionKind {
  ACCEPTED
  REJECTED
}

enum AutoAcceptTier {
  CLEAR
  LIKELY
  AMBIGUOUS
  INSUFFICIENT
}

enum AutoAcceptOutcome {
  ACCEPTED
  SKIPPED
}

model Team {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique
  name            String
  visibility      TeamVisibility  @default(PRIVATE)
  nextIssueNumber Int             @default(1)
  states          WorkflowState[]
  issues          Issue[]
  memberships     TeamMembership[]
  projects        Project[]
  cycles          Cycle[]
  idempotencyKeys WorkIdempotency[]
  webhookSubscriptions WebhookSubscription[]
  agentCredentials AgentCredential[]

  @@index([key])
}

model WorkflowState {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  type     WorkflowStateType @default(UNSTARTED)
  position Int               @default(0)
  teamId   String            @db.Uuid
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues   Issue[]

  @@unique([id, teamId])
  @@unique([teamId, name])
  @@index([teamId])
}

model IssueLabel {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  issues Issue[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  avatarUrl      String?
  googleSubject  String?   @unique
  globalRole     GlobalRole @default(USER)
  actorKind      ActorKind @default(HUMAN)
  // Addressable alias for `@handle` mentions. Stored lowercase; the actorId is
  // the identity, the handle is only a way to spell it (docs/54 §B1).
  handle         String?   @unique
  // Self-declared actor profile (INV-573). Involute stores these and shows
  // them; it never interprets them. Which runtime an agent happens to be is
  // exactly the thing docs/54 §A says the kernel must not know about — but a
  // person reading a comment does need to know, so the agent declares it.
  runtime        String?
  description    String?
  // A2A Agent Card location. Declared now so an actor can carry it; fetching
  // and honouring it is INV-557 (P4).
  agentCardUrl   String?
  // Last time this actor authenticated. The only evidence the server has for
  // "is it around", and the basis for the derived presence.
  lastSeenAt     DateTime?
  // The human accountable for a non-human actor and the terminal target of its
  // escalations (INV-586). A responsibility, not a permission: owning an actor
  // grants no rights over what it writes, and does not mean each execution was
  // the owner's instruction. Kept distinct from Issue.assignee,
  // AgentRequest.requestedByActorId and the authorizer of any one execution.
  ownerId        String?   @db.Uuid
  owner          User?     @relation("ActorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownedActors    User[]    @relation("ActorOwner")
  actorAudits    ActorAudit[] @relation("ActorAuditSubject")
  decisionReceipts DecisionReceipt[] @relation("DecisionReceiptActor")
  actorAuditsMade ActorAudit[] @relation("ActorAuditActor")
  // Actors are deactivated, never deleted: their id stays valid forever so the
  // audit trail keeps pointing at a real row. A deactivated actor cannot
  // authenticate and is not mentionable.
  deactivatedAt  DateTime?
  notificationPrefs Json    @default("{}")
  assignedIssues Issue[]   @relation("IssueAssignee")
  comments       Comment[]
  memberships    TeamMembership[]
  sessions       Session[]
  ledProjects    Project[] @relation("ProjectLead")
  uploads        Attachment[] @relation("Uploads")
  workLinks      WorkLink[] @relation("WorkLinkActor")
  workAudits     WorkAudit[] @relation("WorkAuditActor")
  workClaims     WorkClaim[] @relation("WorkClaimActor")
  workRuns       WorkRun[]   @relation("WorkRunActor")
  workEvidence   WorkEvidence[] @relation("WorkEvidenceActor")
  retractedEvidence   WorkEvidence[] @relation("WorkEvidenceRetractedBy")
  reviewDecisions WorkReviewDecision[] @relation("WorkReviewDecisionReviewer")
  autoAcceptEvaluations WorkAutoAcceptEvaluation[] @relation("WorkAutoAcceptEvaluationActor")
  agentCredentials AgentCredential[]
  createdWebhooks WebhookSubscription[] @relation("WebhookSubscriptionCreator")
  notifications  Notification[]
  commentMentions CommentMention[] @relation("CommentMentionActor")
  // Who picks up this actor's requests when its deadline passes (docs/54 §D3).
  // The name is fixed here; automatic takeover is P3 (INV-556) — today it only
  // answers "who should I ask instead".
  successorActorId String?  @db.Uuid
  successorActor   User?    @relation("ActorSuccessor", fields: [successorActorId], references: [id], onDelete: SetNull)
  succeedsActors   User[]   @relation("ActorSuccessor")
  agentRequestsTargeted AgentRequest[] @relation("AgentRequestTarget")
  agentRequestsMade     AgentRequest[] @relation("AgentRequestRequester")
  agentRequestsClaimed  AgentRequest[] @relation("AgentRequestClaimant")
}

model AgentCredential {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String?  @db.Uuid
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scopes    String[] @default(["read", "propose", "claim", "report", "update", "link", "answer"])
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([revokedAt, expiresAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamMembership {
  id        String             @id @default(uuid()) @db.Uuid
  teamId    String             @db.Uuid
  userId    String             @db.Uuid
  role      TeamMembershipRole
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Issue {
  id                String            @id @default(uuid()) @db.Uuid
  identifier        String            @unique
  title             String
  description       String?
  stateId           String            @db.Uuid
  state             WorkflowState     @relation(fields: [stateId, teamId], references: [id, teamId], onDelete: Restrict)
  assigneeId        String?           @db.Uuid
  assignee          User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentId          String?           @db.Uuid
  parent            Issue?            @relation("IssueParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]           @relation("IssueParentChild")
  teamId            String            @db.Uuid
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  priority          Int               @default(0)
  kind              WorkKind          @default(ISSUE)
  commitmentStatus  CommitmentStatus  @default(COMMITTED)
  revision          Int               @default(1)
  // Candidate-pool governance: snoozed candidates leave the review queue
  // until snoozedUntil passes; committed work ignores this field.
  snoozedUntil      DateTime?
  source            String?
  outcome           String?
  scope             String?
  constraints       String?
  acceptance        String?
  verification      String?
  repository        String?
  // INV-459: per-project reference alias (e.g. LUM on the lumenbox PROJECT
  // node) — alias-prefixed PR references canonicalize to the team key.
  alias             String?
  labels            IssueLabel[]
  comments          Comment[]
  agentRequests     AgentRequest[]
  projectId         String?           @db.Uuid
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycleId           String?           @db.Uuid
  cycle             Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  outgoingLinks     WorkLink[]        @relation("WorkLinkFrom")
  incomingLinks     WorkLink[]        @relation("WorkLinkTo")
  audits            WorkAudit[]
  claim             WorkClaim?
  idempotencyKeys   WorkIdempotency[]
  runs              WorkRun[]
  evidence          WorkEvidence[]
  supersedingEvidence WorkEvidence[] @relation("WorkEvidenceSupersededBy")
  reviewDecisions   WorkReviewDecision[]
  autoAcceptEvaluations WorkAutoAcceptEvaluation[]
  notifications     Notification[]
  // Phase 2: GitHub webhook PR provenance tracking
  stateSourcePrId      String?
  lastAppliedEventTime DateTime?
  webhookEventLogs     WebhookEventLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([teamId])
  @@index([stateId, teamId])
  @@index([stateId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([projectId])
  @@index([cycleId])
  @@index([kind])
  @@index([commitmentStatus])
  @@index([repository])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  issueId     String       @db.Uuid
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Threads are one level deep: a reply points at the thread root, never at
  // another reply, so `rootCommentId` is unambiguous and a work item can carry
  // several independent conversations at once (docs/54 §C, INV-561).
  parentCommentId String?  @db.Uuid
  parentComment   Comment? @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentThread")
  attachments Attachment[]
  mentions    CommentMention[]
  rootedAgentRequests   AgentRequest[] @relation("AgentRequestRoot")
  answeredAgentRequests AgentRequest[] @relation("AgentRequestAnswer")

  @@index([issueId, createdAt])
  @@index([userId])
  @@index([parentCommentId, createdAt])
  @@index([issueId, parentCommentId, createdAt])
}

// What the actor knew when it wrote (INV-588). Attached 1:1 to the WorkAudit
// row of the write it explains; the audit is the immutable event, the receipt
// is the actor's own statement about it. Identity and time are copied from the
// audit by the server — an agent cannot claim to be someone else here — and the
// reasoning and references are the agent's. Always rendered as a claim.
model DecisionReceipt {
  id               String    @id @default(uuid()) @db.Uuid
  auditId          String    @unique @db.Uuid
  // Cascade, not Restrict: the receipt is part of the audit's record. If the
  // audit is ever removed (issue deletion cascades audits today), a receipt
  // with nothing to explain must not block that — the retention contract for
  // deleted issues' audits is a separate decision (actor-model E).
  audit            WorkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actorId          String    @db.Uuid
  actor            User      @relation("DecisionReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  sessionId        String?
  // Snapshot of the runtime at the moment, not the actor's current runtime.
  runtime          String?
  contractRevision Int
  reasoning        String
  // [{ kind, ref, version?, digest?, excerpt?, preserved: bool }]
  evidence         Json      @default("[]")
  inputs           Json      @default("[]")
  createdAt        DateTime  @default(now())

  @@index([actorId, createdAt])
}

// Immutable record of a change to an actor itself — owner transfer,
// deactivation, provisioning. WorkAudit is per work item and cannot hold
// these (INV-586).
model ActorAudit {
  id         String   @id @default(uuid()) @db.Uuid
  subjectId  String   @db.Uuid
  subject    User     @relation("ActorAuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  action     String
  byActorId  String?  @db.Uuid
  byActor    User?    @relation("ActorAuditActor", fields: [byActorId], references: [id], onDelete: Restrict)
  before     Json?
  after      Json
  reason     String?
  createdAt  DateTime @default(now())

  @@index([subjectId, createdAt])
}

// A question put to one actor, with a state, a deadline and an owner — the
// ledger docs/54 §B2 asks for. Claiming and answering happen here rather than
// in a consumer, so two sidecars polling the same actor cannot both answer.
model AgentRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  workId             String            @db.Uuid
  work               Issue             @relation(fields: [workId], references: [id], onDelete: Cascade)
  // The thread this request is anchored to. One work item can carry several
  // independent requests, so the thread — not the work item — is the unit.
  rootCommentId      String            @db.Uuid
  rootComment        Comment           @relation("AgentRequestRoot", fields: [rootCommentId], references: [id], onDelete: Cascade)
  targetActorId      String            @db.Uuid
  targetActor        User              @relation("AgentRequestTarget", fields: [targetActorId], references: [id], onDelete: Cascade)
  requestedByActorId String            @db.Uuid
  requestedByActor   User              @relation("AgentRequestRequester", fields: [requestedByActorId], references: [id], onDelete: Cascade)
  body               String
  state              AgentRequestState @default(SUBMITTED)
  deadlineAt         DateTime
  canceledAt         DateTime?
  // Lease, same idea as the outbox flush claim: a consumer that dies holding a
  // request must not hold it forever.
  claimedBy          String?           @db.Uuid
  claimedByActor     User?             @relation("AgentRequestClaimant", fields: [claimedBy], references: [id], onDelete: SetNull)
  claimedAt          DateTime?
  claimExpiresAt     DateTime?
  // Which *execution* holds the claim, not just which actor. Two sessions can
  // carry the same actor credential; without this a stale session could answer
  // after a fresh one re-claimed. Every take mints a new generation and token;
  // renewal and answer must present the token (INV-573 P1).
  claimGeneration    Int               @default(0)
  claimTokenHash     String?
  // Set before the state reaches COMPLETED: an answer that produced no comment
  // is not an answer.
  answeredCommentId  String?           @unique @db.Uuid
  answeredComment    Comment?          @relation("AgentRequestAnswer", fields: [answeredCommentId], references: [id], onDelete: SetNull)
  failureReason      String?
  payingPrincipal    String?
  idempotencyKey     String?           @unique
  // Hand-off chain (INV-589). A hand-off never reassigns a request; it
  // terminates this one and opens a new one on the same thread, linked here.
  // rootRequestId is the first request in the chain; hopCount and
  // chainDeadlineAt are what make the chain terminate — "every actor has an
  // owner" does not (A.successor = B, B.successor = A never reaches one).
  rootRequestId      String?           @db.Uuid
  handedOffFromId    String?           @db.Uuid
  hopCount           Int               @default(0)
  chainDeadlineAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([targetActorId, state, createdAt])
  @@index([workId, createdAt])
  @@index([state, deadlineAt])
  @@index([rootCommentId])
  @@index([rootRequestId])
}

// Server-side resolution of `@handle` in a comment body to the mentioned
// actor. Written in the same transaction as the comment so consumers read
// actorIds, never raw strings: string matching in a sidecar would double-fire
// with two consumers and would treat `@foo` inside a code block as a mention
// (docs/54 §E1, handoff B1).
model CommentMention {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actorId   String   @db.Uuid
  actor     User     @relation("CommentMentionActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, actorId])
  @@index([actorId, createdAt])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String    @default("#6366f1")
  status      String    @default("planned")
  targetDate  DateTime?
  teamId      String    @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leadId      String?   @db.Uuid
  lead        User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      Issue[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamId])
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  number    Int
  startsAt  DateTime
  endsAt    DateTime
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String
  mimeType   String
  size       Int
  url        String
  issueId    String?  @db.Uuid
  issue      Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  commentId  String?  @db.Uuid
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploaderId String   @db.Uuid
  uploader   User     @relation("Uploads", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([issueId])
  @@index([commentId])
  @@index([uploaderId])
}

model LegacyLinearMapping {
  id         String   @id @default(uuid()) @db.Uuid
  oldId      String
  newId      String
  entityType String
  migratedAt DateTime @default(now())

  @@unique([oldId, entityType])
  @@unique([newId, entityType])
  @@index([entityType])
}

model WorkLink {
  id        String       @id @default(uuid()) @db.Uuid
  type      WorkLinkType
  fromId    String       @db.Uuid
  from      Issue        @relation("WorkLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String       @db.Uuid
  to        Issue        @relation("WorkLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  actorId   String?      @db.Uuid
  actor     User?        @relation("WorkLinkActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@unique([fromId, toId, type])
  @@index([fromId, type])
  @@index([toId, type])
  @@index([actorId])
}

model WorkAudit {
  id              String     @id @default(uuid()) @db.Uuid
  workId          String     @db.Uuid
  work            Issue      @relation(fields: [workId], references: [id], onDelete: Cascade)
  revision        Int
  actorKind       ActorKind
  actorId         String?    @db.Uuid
  // Restrict, not SetNull: an audit row that loses its actor is the orphan
  // problem this model exists to remove. Deactivate the actor instead.
  actor           User?      @relation("WorkAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  surface         String?
  sessionId       String?
  sourceMessageId String?
  reason          String?
  // Which claim generation the acting execution held, for request events
  // (INV-587). Lets a receipt or a reviewer tie the write to the execution
  // that was entitled to make it, not just to the actor.
  claimGeneration Int?
  before          Json?
  after           Json
  createdAt       DateTime   @default(now())
  receipt         DecisionReceipt?

  @@index([workId, createdAt])
  @@index([actorId])
}

model WorkClaim {
  id         String   @id @default(uuid()) @db.Uuid
  workId     String   @unique @db.Uuid
  work       Issue    @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId    String   @db.Uuid
  actor      User     @relation("WorkClaimActor", fields: [actorId], references: [id], onDelete: Cascade)
  leaseUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       WorkRun[]

  @@index([actorId])
  @@index([leaseUntil])
}

model WorkIdempotency {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  operation String
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorKey  String
  requestHash String
  workId    String?  @db.Uuid
  work      Issue?   @relation(fields: [workId], references: [id], onDelete: SetNull)
  resultId  String?  @db.Uuid
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([teamId, actorKey, operation, key], name: "work_idempotency_scope")
  @@index([teamId])
  @@index([workId])
}

model AppSequence {
  name  String @id
  value Int
}

model WorkRun {
  id          String        @id @default(uuid()) @db.Uuid
  publicId    String        @unique
  workId      String        @db.Uuid
  work        Issue         @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId     String?       @db.Uuid
  actor       User?         @relation("WorkRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  claimId     String?       @db.Uuid
  claim       WorkClaim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  baseRevision Int?
  // Content-addressed semantic contract; legacy runs remain unbound.
  contractRevision String?
  acceptanceDigest String?
  contractSnapshot Json?
  claimSnapshotId String? @db.Uuid
  repository String?
  commitSha String?
  pullRequestNumber Int?
  status      WorkRunStatus @default(RUNNING)
  phase       String?
  summary     String?
  externalUrl String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  evidence    WorkEvidence[]
  reviewDecisions WorkReviewDecision[]
  autoAcceptEvaluations WorkAutoAcceptEvaluation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workId, createdAt])
  @@index([actorId])
  @@index([claimId])
  @@index([status])
}

model WorkEvidence {
  id        String           @id @default(uuid()) @db.Uuid
  workId    String           @db.Uuid
  work      Issue            @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId     String?          @db.Uuid
  run       WorkRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  actorId   String?          @db.Uuid
  actor     User?            @relation("WorkEvidenceActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      WorkEvidenceKind
  url       String
  summary   String?
  verificationNextAt DateTime?
  verificationLeaseId String? @db.Uuid
  verificationLeaseUntil DateTime?
  verifications EvidenceVerification[]
  createdAt DateTime         @default(now())
  // Retraction (INV-598): evidence is never physically deleted. A wrong link
  // is marked retracted — by whom, when, why, and which work item it should
  // have pointed at — so the mistake and its correction are both on record.
  retractedAt        DateTime?
  retractedById      String?   @db.Uuid
  retractedBy        User?     @relation("WorkEvidenceRetractedBy", fields: [retractedById], references: [id], onDelete: SetNull)
  retractReason      String?
  supersededByWorkId String?   @db.Uuid
  supersededByWork   Issue?    @relation("WorkEvidenceSupersededBy", fields: [supersededByWorkId], references: [id], onDelete: SetNull)

  @@index([verificationNextAt])
  @@index([workId, createdAt])
  @@index([runId])
  @@index([actorId])
}

model WorkReviewDecision {
  id             String                 @id @default(uuid()) @db.Uuid
  workId         String                 @db.Uuid
  work           Issue                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId          String?                @db.Uuid
  run            WorkRun?               @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewerId     String                 @db.Uuid
  reviewer       User                   @relation("WorkReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision       WorkReviewDecisionKind
  reason         String?
  fromRevision   Int
  toRevision     Int
  createdAt      DateTime               @default(now())
  autoAcceptEvaluation WorkAutoAcceptEvaluation?

  @@index([workId, createdAt])
  @@index([runId])
  @@index([reviewerId])
}

model WorkAutoAcceptEvaluation {
  id         String            @id @default(uuid()) @db.Uuid
  workId     String            @db.Uuid
  work       Issue             @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId      String?           @db.Uuid
  run        WorkRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  actorId    String?           @db.Uuid
  actor      User?             @relation("WorkAutoAcceptEvaluationActor", fields: [actorId], references: [id], onDelete: SetNull)
  tier       AutoAcceptTier
  outcome    AutoAcceptOutcome
  reasons    String[]
  signals    Json
  decisionId String?           @unique @db.Uuid
  decision   WorkReviewDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([workId, createdAt])
  @@index([runId])
  @@index([tier, outcome])
}

model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  deadLetteredAt DateTime?
  claimedAt   DateTime?
  attempts    Int       @default(0)
  lastError   String?
  deliveries EventOutboxDelivery[]

  @@index([deliveredAt, createdAt])
  @@index([type])
}

model EventOutboxDelivery {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @db.Uuid
  event         EventOutbox @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetHash    String
  attempts      Int         @default(0)
  deliveredAt   DateTime?
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventId, targetHash])
  @@index([deliveredAt, attempts])
  @@index([nextAttemptAt])
}

// Linear-mapped webhook subscriptions: per-endpoint signing secret (shown
// once at create/rotate), optional team scoping (null = all teams), and event
// type filtering (empty = all types). Replaces the single shared
// INVOLUTE_WEBHOOK_URL/SECRET pair, which remains as a legacy fallback while
// no subscription exists.
model WebhookSubscription {
  id                  String   @id @default(uuid()) @db.Uuid
  label               String?
  url                 String
  secret              String
  teamId              String?  @db.Uuid
  team                Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById         String?  @db.Uuid
  createdBy           User?    @relation("WebhookSubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  eventTypes          String[] @default([])
  filterQuery         String?
  enabled             Boolean  @default(true)
  consecutiveFailures Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([teamId])
  @@index([enabled])
}

// Kernel notifications: human-gate signals (decision requests, review
// outcomes) projected from outbox events inside the originating transaction.
// sourceEventId ties a row back to its EventOutbox event; the unique
// constraint makes projection exactly-once per event + recipient.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String?   @db.Uuid
  type          String
  workId        String?   @db.Uuid
  work          Issue?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  sourceEventId String?   @db.Uuid
  payload       Json      @default("{}")
  readAt        DateTime?
  emailedAt     DateTime?
  emailAttempts Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([sourceEventId, userId])
  @@index([userId, readAt, createdAt])
}

// Phase 2: Idempotent GitHub webhook event log with physical unique constraint
// to eliminate TOCTOU races in duplicate event processing.
model WebhookEventLog {
  id              String   @id @default(uuid()) @db.Uuid
  issueId         String   @db.Uuid
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  eventSourceKey  String
  eventType       String
  payload         Json     @default("{}")
  createdAt       DateTime @default(now())

  @@unique([issueId, eventSourceKey], map: "idx_webhook_event_source")
  @@index([issueId])
  @@index([eventSourceKey])
}

// Phase 3: Persistent watermark cursor for reconciliation sync engine.
model SyncWatermark {
  key       String   @id
  watermark DateTime
  updatedAt DateTime @updatedAt
}

// Phase 3: Dead-letter quarantine for poisoned PR events that repeatedly fail.
model SyncDeadLetter {
  id           String   @id @default(uuid()) @db.Uuid
  repository   String
  itemRef      String
  error        String
  attempts     Int      @default(1)
  lastFailedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([repository, itemRef])
  @@index([repository])
}

// Operator migration receipts survive client disconnects and preserve rollback guards.
model WorkGraphMigration {
  id           String    @id @default(uuid()) @db.Uuid
  planHash     String    @unique
  teamId       String    @db.Uuid
  actorId      String?   @db.Uuid
  reason       String
  status       String    @default("APPLIED")
  plan         Json
  before       Json
  after        Json
  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  @@index([teamId, createdAt])
}

// Signed inbound receipts retain their dedupe keys even after payload retention expires.
enum InboundGitHubStatus {
  PENDING
  PROCESSING
  RETRY
  PROCESSED
  DEAD
}

model InboundGitHubDelivery {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String              @default("github")
  deliveryId      String
  payloadHash     String
  eventType       String
  repository      String
  payload         Json?
  status          InboundGitHubStatus  @default(PENDING)
  attempts        Int                 @default(0)
  failureCount    Int                 @default(0)
  availableAt     DateTime            @default(now())
  leaseOwner      String?
  leaseUntil      DateTime?
  lastErrorCode   String?
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  attemptHistory  InboundGitHubAttempt[]
  replays         InboundGitHubReplay[]

  @@unique([provider, deliveryId])
  @@index([status, availableAt, receivedAt])
  @@index([status, leaseUntil])
}

model InboundGitHubAttempt {
  id          String                @id @default(uuid()) @db.Uuid
  deliveryId  String                @db.Uuid
  delivery    InboundGitHubDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  number      Int
  leaseOwner  String
  outcome     String                @default("PROCESSING")
  errorCode   String?
  startedAt   DateTime              @default(now())
  endedAt     DateTime?

  @@unique([deliveryId, number])
}

model InboundGitHubReplay {
  id                String                @id @default(uuid()) @db.Uuid
  deliveryId        String                @db.Uuid
  delivery          InboundGitHubDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reason            String
  source            String                @default("operator-cli")
  previousAttempts  Int
  requestedAt       DateTime              @default(now())
}


enum EvidenceVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  UNAVAILABLE
  STALE
}

// Only the server verifier appends rows; no GraphQL/MCP mutation exposes writes.
model EvidenceVerification {
  id String @id @default(uuid()) @db.Uuid
  evidenceId String @db.Uuid
  evidence WorkEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifierId String
  verifierVersion String
  status EvidenceVerificationStatus
  repository String?
  commitSha String?
  externalRunId String?
  contractRevision String?
  acceptanceDigest String?
  runId String? @db.Uuid
  observedAt DateTime @default(now())
  resultDigest String
  failureCode String?
  result Json
  createdAt DateTime @default(now())

  @@index([evidenceId, createdAt])
}
