generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum TeamMembershipRole {
  VIEWER
  EDITOR
  OWNER
}

enum WorkflowStateType {
  BACKLOG
  UNSTARTED
  STARTED
  REVIEW
  COMPLETED
  CANCELED
}

enum ActorKind {
  HUMAN
  AGENT
  SERVICE
}

enum WorkKind {
  ISSUE
  PROJECT
  MILESTONE
  DECISION
  EPIC
}

enum CommitmentStatus {
  CANDIDATE
  COMMITTED
  REJECTED
}

enum WorkLinkType {
  CONTAINS
  BLOCKS
  DERIVED_FROM
  DISCOVERED_DURING
  RELATED_TO
  DUPLICATE_OF
}

enum WorkRunStatus {
  QUEUED
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
}

enum WorkEvidenceKind {
  PR
  TEST
  LOG
  SCREENSHOT
  ARTIFACT
  DECISION
}

enum WorkReviewDecisionKind {
  ACCEPTED
  REJECTED
}

model Team {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique
  name            String
  visibility      TeamVisibility  @default(PRIVATE)
  nextIssueNumber Int             @default(1)
  states          WorkflowState[]
  issues          Issue[]
  memberships     TeamMembership[]
  projects        Project[]
  cycles          Cycle[]
  idempotencyKeys WorkIdempotency[]

  @@index([key])
}

model WorkflowState {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  type     WorkflowStateType @default(UNSTARTED)
  position Int               @default(0)
  teamId   String            @db.Uuid
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues   Issue[]

  @@unique([id, teamId])
  @@unique([teamId, name])
  @@index([teamId])
}

model IssueLabel {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  issues Issue[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  avatarUrl      String?
  googleSubject  String?   @unique
  globalRole     GlobalRole @default(USER)
  actorKind      ActorKind @default(HUMAN)
  assignedIssues Issue[]   @relation("IssueAssignee")
  comments       Comment[]
  memberships    TeamMembership[]
  sessions       Session[]
  ledProjects    Project[] @relation("ProjectLead")
  uploads        Attachment[] @relation("Uploads")
  workLinks      WorkLink[] @relation("WorkLinkActor")
  workAudits     WorkAudit[] @relation("WorkAuditActor")
  workClaims     WorkClaim[] @relation("WorkClaimActor")
  workRuns       WorkRun[]   @relation("WorkRunActor")
  workEvidence   WorkEvidence[] @relation("WorkEvidenceActor")
  reviewDecisions WorkReviewDecision[] @relation("WorkReviewDecisionReviewer")
  agentCredentials AgentCredential[]
}

model AgentCredential {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([revokedAt, expiresAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamMembership {
  id        String             @id @default(uuid()) @db.Uuid
  teamId    String             @db.Uuid
  userId    String             @db.Uuid
  role      TeamMembershipRole
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Issue {
  id                String            @id @default(uuid()) @db.Uuid
  identifier        String            @unique
  title             String
  description       String?
  stateId           String            @db.Uuid
  state             WorkflowState     @relation(fields: [stateId, teamId], references: [id, teamId], onDelete: Restrict)
  assigneeId        String?           @db.Uuid
  assignee          User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentId          String?           @db.Uuid
  parent            Issue?            @relation("IssueParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]           @relation("IssueParentChild")
  teamId            String            @db.Uuid
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  priority          Int               @default(0)
  kind              WorkKind          @default(ISSUE)
  commitmentStatus  CommitmentStatus  @default(COMMITTED)
  revision          Int               @default(1)
  outcome           String?
  scope             String?
  constraints       String?
  acceptance        String?
  verification      String?
  repository        String?
  labels            IssueLabel[]
  comments          Comment[]
  projectId         String?           @db.Uuid
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycleId           String?           @db.Uuid
  cycle             Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  outgoingLinks     WorkLink[]        @relation("WorkLinkFrom")
  incomingLinks     WorkLink[]        @relation("WorkLinkTo")
  audits            WorkAudit[]
  claim             WorkClaim?
  idempotencyKeys   WorkIdempotency[]
  runs              WorkRun[]
  evidence          WorkEvidence[]
  reviewDecisions   WorkReviewDecision[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([teamId])
  @@index([stateId, teamId])
  @@index([stateId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([projectId])
  @@index([cycleId])
  @@index([kind])
  @@index([commitmentStatus])
  @@index([repository])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  issueId     String       @db.Uuid
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([issueId, createdAt])
  @@index([userId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String    @default("#6366f1")
  status      String    @default("planned")
  targetDate  DateTime?
  teamId      String    @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leadId      String?   @db.Uuid
  lead        User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      Issue[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamId])
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  number    Int
  startsAt  DateTime
  endsAt    DateTime
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String
  mimeType   String
  size       Int
  url        String
  issueId    String?  @db.Uuid
  issue      Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  commentId  String?  @db.Uuid
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploaderId String   @db.Uuid
  uploader   User     @relation("Uploads", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([issueId])
  @@index([commentId])
  @@index([uploaderId])
}

model LegacyLinearMapping {
  id         String   @id @default(uuid()) @db.Uuid
  oldId      String
  newId      String
  entityType String
  migratedAt DateTime @default(now())

  @@unique([oldId, entityType])
  @@unique([newId, entityType])
  @@index([entityType])
}

model WorkLink {
  id        String       @id @default(uuid()) @db.Uuid
  type      WorkLinkType
  fromId    String       @db.Uuid
  from      Issue        @relation("WorkLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String       @db.Uuid
  to        Issue        @relation("WorkLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  actorId   String?      @db.Uuid
  actor     User?        @relation("WorkLinkActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@unique([fromId, toId, type])
  @@index([fromId, type])
  @@index([toId, type])
  @@index([actorId])
}

model WorkAudit {
  id              String     @id @default(uuid()) @db.Uuid
  workId          String     @db.Uuid
  work            Issue      @relation(fields: [workId], references: [id], onDelete: Cascade)
  revision        Int
  actorKind       ActorKind
  actorId         String?    @db.Uuid
  actor           User?      @relation("WorkAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  surface         String?
  sessionId       String?
  sourceMessageId String?
  reason          String?
  before          Json?
  after           Json
  createdAt       DateTime   @default(now())

  @@index([workId, createdAt])
  @@index([actorId])
}

model WorkClaim {
  id         String   @id @default(uuid()) @db.Uuid
  workId     String   @unique @db.Uuid
  work       Issue    @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId    String   @db.Uuid
  actor      User     @relation("WorkClaimActor", fields: [actorId], references: [id], onDelete: Cascade)
  leaseUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([actorId])
  @@index([leaseUntil])
}

model WorkIdempotency {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  operation String
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorKey  String
  requestHash String
  workId    String?  @db.Uuid
  work      Issue?   @relation(fields: [workId], references: [id], onDelete: SetNull)
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([teamId, actorKey, operation, key], name: "work_idempotency_scope")
  @@index([teamId])
  @@index([workId])
}

model AppSequence {
  name  String @id
  value Int
}

model WorkRun {
  id          String        @id @default(uuid()) @db.Uuid
  publicId    String        @unique
  workId      String        @db.Uuid
  work        Issue         @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId     String?       @db.Uuid
  actor       User?         @relation("WorkRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  claimId     String?       @db.Uuid
  baseRevision Int?
  status      WorkRunStatus @default(RUNNING)
  phase       String?
  summary     String?
  externalUrl String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  evidence    WorkEvidence[]
  reviewDecisions WorkReviewDecision[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workId, createdAt])
  @@index([actorId])
  @@index([claimId])
  @@index([status])
}

model WorkEvidence {
  id        String           @id @default(uuid()) @db.Uuid
  workId    String           @db.Uuid
  work      Issue            @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId     String?          @db.Uuid
  run       WorkRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  actorId   String?          @db.Uuid
  actor     User?            @relation("WorkEvidenceActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      WorkEvidenceKind
  url       String
  summary   String?
  createdAt DateTime         @default(now())

  @@index([workId, createdAt])
  @@index([runId])
  @@index([actorId])
}

model WorkReviewDecision {
  id             String                 @id @default(uuid()) @db.Uuid
  workId         String                 @db.Uuid
  work           Issue                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId          String?                @db.Uuid
  run            WorkRun?               @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewerId     String                 @db.Uuid
  reviewer       User                   @relation("WorkReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision       WorkReviewDecisionKind
  reason         String?
  fromRevision   Int
  toRevision     Int
  createdAt      DateTime               @default(now())

  @@index([workId, createdAt])
  @@index([runId])
  @@index([reviewerId])
}

model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  deadLetteredAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  deliveries EventOutboxDelivery[]

  @@index([deliveredAt, createdAt])
  @@index([type])
}

model EventOutboxDelivery {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @db.Uuid
  event       EventOutbox @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetHash  String
  attempts    Int         @default(0)
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([eventId, targetHash])
  @@index([deliveredAt, attempts])
}
