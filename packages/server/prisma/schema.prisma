generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum TeamMembershipRole {
  VIEWER
  EDITOR
  OWNER
}

enum WorkflowStateType {
  BACKLOG
  UNSTARTED
  STARTED
  REVIEW
  COMPLETED
  CANCELED
}

enum ActorKind {
  HUMAN
  AGENT
  SERVICE
}

enum WorkKind {
  ISSUE
  PROJECT
  MILESTONE
  DECISION
  EPIC
}

enum CommitmentStatus {
  CANDIDATE
  COMMITTED
  REJECTED
}

enum WorkLinkType {
  CONTAINS
  BLOCKS
  DERIVED_FROM
  DISCOVERED_DURING
  RELATED_TO
  DUPLICATE_OF
}

enum WorkRunStatus {
  QUEUED
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
}

enum WorkEvidenceKind {
  PR
  TEST
  LOG
  SCREENSHOT
  ARTIFACT
  DECISION
}

enum WorkReviewDecisionKind {
  ACCEPTED
  REJECTED
}

enum AutoAcceptTier {
  CLEAR
  LIKELY
  AMBIGUOUS
  INSUFFICIENT
}

enum AutoAcceptOutcome {
  ACCEPTED
  SKIPPED
}

model Team {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique
  name            String
  visibility      TeamVisibility  @default(PRIVATE)
  nextIssueNumber Int             @default(1)
  states          WorkflowState[]
  issues          Issue[]
  memberships     TeamMembership[]
  projects        Project[]
  cycles          Cycle[]
  idempotencyKeys WorkIdempotency[]
  webhookSubscriptions WebhookSubscription[]
  agentCredentials AgentCredential[]

  @@index([key])
}

model WorkflowState {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  type     WorkflowStateType @default(UNSTARTED)
  position Int               @default(0)
  teamId   String            @db.Uuid
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues   Issue[]

  @@unique([id, teamId])
  @@unique([teamId, name])
  @@index([teamId])
}

model IssueLabel {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  issues Issue[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  avatarUrl      String?
  googleSubject  String?   @unique
  globalRole     GlobalRole @default(USER)
  actorKind      ActorKind @default(HUMAN)
  notificationPrefs Json    @default("{}")
  assignedIssues Issue[]   @relation("IssueAssignee")
  comments       Comment[]
  memberships    TeamMembership[]
  sessions       Session[]
  ledProjects    Project[] @relation("ProjectLead")
  uploads        Attachment[] @relation("Uploads")
  workLinks      WorkLink[] @relation("WorkLinkActor")
  workAudits     WorkAudit[] @relation("WorkAuditActor")
  workClaims     WorkClaim[] @relation("WorkClaimActor")
  workRuns       WorkRun[]   @relation("WorkRunActor")
  workEvidence   WorkEvidence[] @relation("WorkEvidenceActor")
  reviewDecisions WorkReviewDecision[] @relation("WorkReviewDecisionReviewer")
  autoAcceptEvaluations WorkAutoAcceptEvaluation[] @relation("WorkAutoAcceptEvaluationActor")
  agentCredentials AgentCredential[]
  createdWebhooks WebhookSubscription[] @relation("WebhookSubscriptionCreator")
  notifications  Notification[]
}

model AgentCredential {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String?  @db.Uuid
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scopes    String[] @default(["read", "propose", "claim", "report", "update", "link"])
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([revokedAt, expiresAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamMembership {
  id        String             @id @default(uuid()) @db.Uuid
  teamId    String             @db.Uuid
  userId    String             @db.Uuid
  role      TeamMembershipRole
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Issue {
  id                String            @id @default(uuid()) @db.Uuid
  identifier        String            @unique
  title             String
  description       String?
  stateId           String            @db.Uuid
  state             WorkflowState     @relation(fields: [stateId, teamId], references: [id, teamId], onDelete: Restrict)
  assigneeId        String?           @db.Uuid
  assignee          User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentId          String?           @db.Uuid
  parent            Issue?            @relation("IssueParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]           @relation("IssueParentChild")
  teamId            String            @db.Uuid
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  priority          Int               @default(0)
  kind              WorkKind          @default(ISSUE)
  commitmentStatus  CommitmentStatus  @default(COMMITTED)
  revision          Int               @default(1)
  // Candidate-pool governance: snoozed candidates leave the review queue
  // until snoozedUntil passes; committed work ignores this field.
  snoozedUntil      DateTime?
  source            String?
  outcome           String?
  scope             String?
  constraints       String?
  acceptance        String?
  verification      String?
  repository        String?
  labels            IssueLabel[]
  comments          Comment[]
  projectId         String?           @db.Uuid
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycleId           String?           @db.Uuid
  cycle             Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  outgoingLinks     WorkLink[]        @relation("WorkLinkFrom")
  incomingLinks     WorkLink[]        @relation("WorkLinkTo")
  audits            WorkAudit[]
  claim             WorkClaim?
  idempotencyKeys   WorkIdempotency[]
  runs              WorkRun[]
