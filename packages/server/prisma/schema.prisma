generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  // Shown as "Member".
  USER
  // Sees only the teams it was added to and projects shared with it (docs/permissions.md).
  GUEST
}

enum TeamVisibility {
  PRIVATE
  PUBLIC
}

enum TeamMembershipRole {
  VIEWER
  EDITOR
  OWNER
}

enum WorkflowStateType {
  BACKLOG
  UNSTARTED
  STARTED
  REVIEW
  COMPLETED
  CANCELED
}

enum ActorKind {
  HUMAN
  AGENT
  SERVICE
}

enum WorkShareRole {
  VIEWER
  EDITOR
}

enum WorkKind {
  ISSUE
  PROJECT
  MILESTONE
  DECISION
  EPIC
}

enum CommitmentStatus {
  CANDIDATE
  COMMITTED
  REJECTED
}

// INV-1118: why work was closed without being done — set when a candidate is
// rejected or committed work moves to a CANCELED state; cleared on reopen.
enum WorkResolution {
  COMPLETED
  WONT_DO
  INVALID
  DUPLICATE
  CANNOT_REPRODUCE
  OBSOLETE
}

enum WorkLinkType {
  CONTAINS
  BLOCKS
  DERIVED_FROM
  DISCOVERED_DURING
  RELATED_TO
  DUPLICATE_OF
}

enum WorkRunStatus {
  QUEUED
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
}

// Borrowed verbatim from A2A's task lifecycle rather than invented here. The
// wire spellings are A2A's (`submitted`, `working`, `input-required`,
// `completed`, `failed`, `canceled`); these identifiers are the same names in
// the spelling Prisma enums allow, mapped in agent-request-state.ts.
enum AgentRequestState {
  SUBMITTED
  WORKING
  INPUT_REQUIRED
  COMPLETED
  FAILED
  CANCELED
}

enum WorkEvidenceKind {
  PR
  TEST
  LOG
  SCREENSHOT
  ARTIFACT
  DECISION
}

enum WorkReviewDecisionKind {
  ACCEPTED
  REJECTED
}

enum AutoAcceptTier {
  CLEAR
  LIKELY
  AMBIGUOUS
  INSUFFICIENT
}

enum AutoAcceptOutcome {
  ACCEPTED
  SKIPPED
}

// Impact, separate from priority (INV-1115): priority orders the work and sets
// a bug's SLA; severity says how bad the effect is. Definitions in
// docs/severity.md.
enum IssueSeverity {
  SEV1
  SEV2
  SEV3
}

// A saved board/backlog view kept on the server (INV-1005): private to its
// owner or shared with the team, visible on every device.
model SavedView {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @db.Uuid
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ownerId    String   @db.Uuid
  owner      User     @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  // board | backlog
  kind       String
  // PRIVATE | TEAM
  visibility String   @default("PRIVATE")
  state      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([teamId, visibility])
  @@index([ownerId])
}

model Team {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique
  name            String
  visibility      TeamVisibility  @default(PRIVATE)
  // Archived teams are read-only and hidden from the sidebar; never deleted (docs/permissions.md §5).
  archivedAt      DateTime?
  nextIssueNumber Int             @default(1)
  states          WorkflowState[]
  issues          Issue[]
  memberships     TeamMembership[]
  projects        Project[]
  cycles          Cycle[]
  idempotencyKeys WorkIdempotency[]
  webhookSubscriptions WebhookSubscription[]
  agentCredentials AgentCredential[]
  /// Weekly bug triage rotation (INV-750): { userIds: string[], startsAt: ISO date }.
  triageRotation  Json?

  @@index([key])
  savedViews      SavedView[]
}

model WorkflowState {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  type     WorkflowStateType @default(UNSTARTED)
  position Int               @default(0)
  teamId   String            @db.Uuid
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues   Issue[]

  @@unique([id, teamId])
  @@unique([teamId, name])
  @@index([teamId])
}

model IssueLabel {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  issues Issue[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  avatarUrl      String?
  googleSubject  String?   @unique
  globalRole     GlobalRole @default(USER)
  actorKind      ActorKind @default(HUMAN)
  // Addressable alias for `@handle` mentions. Stored lowercase; the actorId is
  // the identity, the handle is only a way to spell it (docs/54 §B1).
  handle         String?   @unique
  // Self-declared actor profile (INV-573). Involute stores these and shows
  // them; it never interprets them. Which runtime an agent happens to be is
  // exactly the thing docs/54 §A says the kernel must not know about — but a
  // person reading a comment does need to know, so the agent declares it.
  runtime        String?
  description    String?
  // A2A Agent Card location. Declared now so an actor can carry it; fetching
  // and honouring it is INV-557 (P4).
  agentCardUrl   String?
  // Last time this actor authenticated. The only evidence the server has for
  // "is it around", and the basis for the derived presence.
  lastSeenAt     DateTime?
  // The human accountable for a non-human actor and the terminal target of its
  // escalations (INV-586). A responsibility, not a permission: owning an actor
  // grants no rights over what it writes, and does not mean each execution was
  // the owner's instruction. Kept distinct from Issue.assignee,
  // AgentRequest.requestedByActorId and the authorizer of any one execution.
  ownerId        String?   @db.Uuid
  owner          User?     @relation("ActorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownedActors    User[]    @relation("ActorOwner")
  actorAudits    ActorAudit[] @relation("ActorAuditSubject")
  decisionReceipts DecisionReceipt[] @relation("DecisionReceiptActor")
  actorAuditsMade ActorAudit[] @relation("ActorAuditActor")
  // Actors are deactivated, never deleted: their id stays valid forever so the
  // audit trail keeps pointing at a real row. A deactivated actor cannot
  // authenticate and is not mentionable.
  deactivatedAt  DateTime?
  // An invite is a user row created before its first sign-in (docs/permissions.md §2.2).
  // Pending while googleSubject is null.
  invitedAt      DateTime?
  invitedById    String?   @db.Uuid
  invitedBy      User?     @relation("UserInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]    @relation("UserInviter")
  // When the row was made (INV-604). Null for actors that predate the column
  // and left no earlier trace; never backfilled with a guess.
  createdAt      DateTime? @default(now())
  issuedCredentials AgentCredential[] @relation("CredentialIssuer")
  deliveryApprovals DeliveryPackage[] @relation("DeliveryApprover")
  deliveryProposals DeliveryChangeSet[] @relation("DeliveryProposer")
  deliveryDecisions DeliveryChangeSet[] @relation("DeliveryDecider")
  workShares     WorkShare[] @relation("WorkShareUser")
  workSharesMade WorkShare[] @relation("WorkShareCreator")
  notificationPrefs Json    @default("{}")
  assignedIssues Issue[]   @relation("IssueAssignee")
  comments       Comment[]
  memberships    TeamMembership[]
  sessions       Session[]
  ledProjects    Project[] @relation("ProjectLead")
  uploads        Attachment[] @relation("Uploads")
  workLinks      WorkLink[] @relation("WorkLinkActor")
  workAudits     WorkAudit[] @relation("WorkAuditActor")
  workClaims     WorkClaim[] @relation("WorkClaimActor")
  workRuns       WorkRun[]   @relation("WorkRunActor")
  workEvidence   WorkEvidence[] @relation("WorkEvidenceActor")
  retractedEvidence   WorkEvidence[] @relation("WorkEvidenceRetractedBy")
  reviewDecisions WorkReviewDecision[] @relation("WorkReviewDecisionReviewer")
  proposedContractAmendments ContractAmendment[] @relation("ContractAmendmentProposer")
  decidedContractAmendments  ContractAmendment[] @relation("ContractAmendmentDecider")
  autoAcceptEvaluations WorkAutoAcceptEvaluation[] @relation("WorkAutoAcceptEvaluationActor")
  agentCredentials AgentCredential[]
  createdWebhooks WebhookSubscription[] @relation("WebhookSubscriptionCreator")
  notifications  Notification[]
  commentMentions CommentMention[] @relation("CommentMentionActor")
  // Who picks up this actor's requests when its deadline passes (docs/54 §D3).
  // The name is fixed here; automatic takeover is P3 (INV-556) — today it only
  // answers "who should I ask instead".
  successorActorId String?  @db.Uuid
  successorActor   User?    @relation("ActorSuccessor", fields: [successorActorId], references: [id], onDelete: SetNull)
  succeedsActors   User[]   @relation("ActorSuccessor")
  agentRequestsTargeted AgentRequest[] @relation("AgentRequestTarget")
  agentRequestsMade     AgentRequest[] @relation("AgentRequestRequester")
  agentRequestsClaimed  AgentRequest[] @relation("AgentRequestClaimant")
  pushSubscriptions    WebhookSubscription[] @relation("WebhookSubscriptionActor")
  savedViews           SavedView[]          @relation("SavedViewOwner")
}

model AgentCredential {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String?  @db.Uuid
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scopes    String[] @default(["read", "propose", "claim", "report", "update", "link", "answer"])
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  // The human who minted it (INV-604). Null for operator-CLI issuance and rows
  // that predate the column.
  issuedById String? @db.Uuid
  issuedBy   User?   @relation("CredentialIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([revokedAt, expiresAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamMembership {
  id        String             @id @default(uuid()) @db.Uuid
  teamId    String             @db.Uuid
  userId    String             @db.Uuid
  role      TeamMembershipRole
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Issue {
  id                String            @id @default(uuid()) @db.Uuid
  identifier        String            @unique
  title             String
  description       String?
  stateId           String            @db.Uuid
  state             WorkflowState     @relation(fields: [stateId, teamId], references: [id, teamId], onDelete: Restrict)
  assigneeId        String?           @db.Uuid
  assignee          User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Who this PROJECT node is shared with beyond its team (INV-832).
  shares            WorkShare[]
  parentId          String?           @db.Uuid
  parent            Issue?            @relation("IssueParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]           @relation("IssueParentChild")
  teamId            String            @db.Uuid
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  priority          Int               @default(0)
  severity          IssueSeverity?
  kind              WorkKind          @default(ISSUE)
  commitmentStatus  CommitmentStatus  @default(COMMITTED)
  revision          Int               @default(1)
  // Candidate-pool governance: snoozed candidates leave the review queue
  // until snoozedUntil passes; committed work ignores this field.
  snoozedUntil      DateTime?
  source            String?
  outcome           String?
  scope             String?
  constraints       String?
  acceptance        String?
  verification      String?
  repository        String?
  // INV-459: per-project reference alias (e.g. LUM on the lumenbox PROJECT
  // node) — alias-prefixed PR references canonicalize to the team key.
  alias             String?
  // INV-1075: on a PROJECT, bugs whose fix GitHub confirms (merged, checks green)
  // are accepted by the Auto-Accept Gate. Off by default; only people turn it on.
  autoAcceptBugs    Boolean           @default(false)
  // INV-1118: structured close reason; the free-text reason stays on WorkAudit.
  resolution        WorkResolution?
  labels            IssueLabel[]
  comments          Comment[]
  embeddings        IssueEmbedding[]
  agentRequests     AgentRequest[]
  projectId         String?           @db.Uuid
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycleId           String?           @db.Uuid
  cycle             Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  outgoingLinks     WorkLink[]        @relation("WorkLinkFrom")
  incomingLinks     WorkLink[]        @relation("WorkLinkTo")
  audits            WorkAudit[]
  bugSlaAlerts      BugSlaAlert[]
  claim             WorkClaim?
  idempotencyKeys   WorkIdempotency[]
  runs              WorkRun[]
  evidence          WorkEvidence[]
  supersedingEvidence WorkEvidence[] @relation("WorkEvidenceSupersededBy")
  reviewDecisions   WorkReviewDecision[]
  contractAmendments ContractAmendment[]
  autoAcceptEvaluations WorkAutoAcceptEvaluation[]
  notifications     Notification[]
  // Execution provenance survives removal of a package: missing authorization fails closed.
  deliveryRootId String? @db.Uuid
  deliveryUnitKey String?
  deliveryGrantRevision Int?
  deliveryPackage DeliveryPackage?
  deliveryChanges DeliveryChangeSet[]
  supersededById String? @db.Uuid
  supersededBy Issue? @relation("SupersededWork", fields: [supersededById], references: [id], onDelete: Restrict)
  supersededWorks Issue[] @relation("SupersededWork")
  // Phase 2: GitHub webhook PR provenance tracking
  stateSourcePrId      String?
  lastAppliedEventTime DateTime?
  webhookEventLogs     WebhookEventLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([teamId])
  @@index([stateId, teamId])
  @@index([stateId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([projectId])
  @@index([cycleId])
  @@index([kind])
  @@index([commitmentStatus])
  /// Ranked search terms (INV-926). Written only by the database trigger; see migration 20261002020000_search_vector.
  searchVector      Unsupported("tsvector")?

  @@index([repository])
  // Trigram indexes behind free-text search (INV-925); pg_trgm is created by the migration.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Issue_title_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "Issue_description_trgm_idx", type: Gin)
  @@index([searchVector], map: "Issue_searchVector_idx", type: Gin)
  @@unique([deliveryRootId, deliveryUnitKey, deliveryGrantRevision])

}

/// Semantic search vector of a work item (INV-927): one per item and model,
/// rebuilt in the background when the embedded text (contentHash) changes.
model DeliveryPackage {
  workId String @id @db.Uuid
  work Issue @relation(fields: [workId], references: [id], onDelete: Cascade)
  revision Int @default(1)
  policy Json
  contractDigest String
  approvedById String @db.Uuid
  approvedBy User @relation("DeliveryApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt DateTime @default(now())
  revokedAt DateTime?
}

model DeliveryChangeSet {
  id String @id @default(uuid()) @db.Uuid
  workId String @db.Uuid
  work Issue @relation(fields: [workId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  reason String
  changes Json
  before Json
  proposedById String @db.Uuid
  proposedBy User @relation("DeliveryProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedById String? @db.Uuid
  decidedBy User? @relation("DeliveryDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionNote String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([status, createdAt])
}

model IssueEmbedding {
  issueId     String   @db.Uuid
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  model       String
  contentHash String
  vector      Float[]  @db.Real
  updatedAt   DateTime @updatedAt

  @@id([issueId, model])
  @@index([model])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  issueId     String       @db.Uuid
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Threads are one level deep: a reply points at the thread root, never at
  // another reply, so `rootCommentId` is unambiguous and a work item can carry
  // several independent conversations at once (docs/54 §C, INV-561).
  parentCommentId String?  @db.Uuid
  parentComment   Comment? @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentThread")
  attachments Attachment[]
  mentions    CommentMention[]
  rootedAgentRequests   AgentRequest[] @relation("AgentRequestRoot")
  answeredAgentRequests AgentRequest[] @relation("AgentRequestAnswer")
  /// Ranked search terms (INV-926), written only by the database trigger.
  searchVector Unsupported("tsvector")?

  @@index([issueId, createdAt])
  @@index([userId])
  @@index([parentCommentId, createdAt])
  @@index([issueId, parentCommentId, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], map: "Comment_body_trgm_idx", type: Gin)
  @@index([searchVector], map: "Comment_searchVector_idx", type: Gin)
}

// What the actor knew when it wrote (INV-588). Attached 1:1 to the WorkAudit
// row of the write it explains; the audit is the immutable event, the receipt
// is the actor's own statement about it. Identity and time are copied from the
// audit by the server — an agent cannot claim to be someone else here — and the
// reasoning and references are the agent's. Always rendered as a claim.
model DecisionReceipt {
  id               String    @id @default(uuid()) @db.Uuid
  auditId          String    @unique @db.Uuid
  // Cascade, not Restrict: the receipt is part of the audit's record. If the
  // audit is ever removed (issue deletion cascades audits today), a receipt
  // with nothing to explain must not block that — the retention contract for
  // deleted issues' audits is a separate decision (actor-model E).
  audit            WorkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actorId          String    @db.Uuid
  actor            User      @relation("DecisionReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  sessionId        String?
  // Snapshot of the runtime at the moment, not the actor's current runtime.
  runtime          String?
  contractRevision Int
  reasoning        String
  // [{ kind, ref, version?, digest?, excerpt?, preserved: bool }]
  evidence         Json      @default("[]")
  inputs           Json      @default("[]")
  createdAt        DateTime  @default(now())

  @@index([actorId, createdAt])
}

// Immutable record of a change to an actor itself — owner transfer,
// deactivation, provisioning. WorkAudit is per work item and cannot hold
// these (INV-586).
model ActorAudit {
  id         String   @id @default(uuid()) @db.Uuid
  subjectId  String   @db.Uuid
  subject    User     @relation("ActorAuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  action     String
  byActorId  String?  @db.Uuid
  byActor    User?    @relation("ActorAuditActor", fields: [byActorId], references: [id], onDelete: Restrict)
  before     Json?
  after      Json
  reason     String?
  createdAt  DateTime @default(now())

  @@index([subjectId, createdAt])
}

// A question put to one actor, with a state, a deadline and an owner — the
// ledger docs/54 §B2 asks for. Claiming and answering happen here rather than
// in a consumer, so two sidecars polling the same actor cannot both answer.
model AgentRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  workId             String            @db.Uuid
  work               Issue             @relation(fields: [workId], references: [id], onDelete: Cascade)
  // The thread this request is anchored to. One work item can carry several
  // independent requests, so the thread — not the work item — is the unit.
  rootCommentId      String            @db.Uuid
  rootComment        Comment           @relation("AgentRequestRoot", fields: [rootCommentId], references: [id], onDelete: Cascade)
  targetActorId      String            @db.Uuid
  targetActor        User              @relation("AgentRequestTarget", fields: [targetActorId], references: [id], onDelete: Cascade)
  requestedByActorId String            @db.Uuid
  requestedByActor   User              @relation("AgentRequestRequester", fields: [requestedByActorId], references: [id], onDelete: Cascade)
  body               String
  state              AgentRequestState @default(SUBMITTED)
  deadlineAt         DateTime
  canceledAt         DateTime?
  // Lease, same idea as the outbox flush claim: a consumer that dies holding a
  // request must not hold it forever.
  claimedBy          String?           @db.Uuid
  claimedByActor     User?             @relation("AgentRequestClaimant", fields: [claimedBy], references: [id], onDelete: SetNull)
  claimedAt          DateTime?
  claimExpiresAt     DateTime?
  // Which *execution* holds the claim, not just which actor. Two sessions can
  // carry the same actor credential; without this a stale session could answer
  // after a fresh one re-claimed. Every take mints a new generation and token;
  // renewal and answer must present the token (INV-573 P1).
  claimGeneration    Int               @default(0)
  claimTokenHash     String?
  // Set before the state reaches COMPLETED: an answer that produced no comment
  // is not an answer.
  answeredCommentId  String?           @unique @db.Uuid
  answeredComment    Comment?          @relation("AgentRequestAnswer", fields: [answeredCommentId], references: [id], onDelete: SetNull)
  failureReason      String?
  payingPrincipal    String?
  idempotencyKey     String?           @unique
  // Hand-off chain (INV-589). A hand-off never reassigns a request; it
  // terminates this one and opens a new one on the same thread, linked here.
  // rootRequestId is the first request in the chain; hopCount and
  // chainDeadlineAt are what make the chain terminate — "every actor has an
  // owner" does not (A.successor = B, B.successor = A never reaches one).
  rootRequestId      String?           @db.Uuid
  handedOffFromId    String?           @db.Uuid
  hopCount           Int               @default(0)
  chainDeadlineAt    DateTime?
  // A needinfo (INV-1119): raised explicitly to a named person, human or agent.
  // Any comment its target writes on the work answers it, and while it waits
  // on a bug's reporter that bug's SLA clock is paused.
  needInfo           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([targetActorId, state, createdAt])
  @@index([workId, needInfo, state])
  @@index([workId, createdAt])
  @@index([state, deadlineAt])
  @@index([rootCommentId])
  @@index([rootRequestId])
}

// Server-side resolution of `@handle` in a comment body to the mentioned
// actor. Written in the same transaction as the comment so consumers read
// actorIds, never raw strings: string matching in a sidecar would double-fire
// with two consumers and would treat `@foo` inside a code block as a mention
// (docs/54 §E1, handoff B1).
model CommentMention {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actorId   String   @db.Uuid
  actor     User     @relation("CommentMentionActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, actorId])
  @@index([actorId, createdAt])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String    @default("#6366f1")
  status      String    @default("planned")
  targetDate  DateTime?
  teamId      String    @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leadId      String?   @db.Uuid
  lead        User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      Issue[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamId])
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  number    Int
  startsAt  DateTime
  endsAt    DateTime
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String
  mimeType   String
  size       Int
  url        String
  issueId    String?  @db.Uuid
  issue      Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  commentId  String?  @db.Uuid
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploaderId String   @db.Uuid
  uploader   User     @relation("Uploads", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  // Text of a text upload, length-capped, for search; null for binaries (INV-1117).
  textContent  String?
  // Full-text vector over textContent, kept by a trigger (INV-1117).
  searchVector Unsupported("tsvector")?

  @@index([issueId])
  @@index([commentId])
  @@index([uploaderId])
  @@index([searchVector], map: "Attachment_searchVector_idx", type: Gin)
}

model LegacyLinearMapping {
  id         String   @id @default(uuid()) @db.Uuid
  oldId      String
  newId      String
  entityType String
  migratedAt DateTime @default(now())

  @@unique([oldId, entityType])
  @@unique([newId, entityType])
  @@index([entityType])
}

/**
 * A PROJECT node shared with one person or agent outside its team (INV-832).
 * The share is the permission carrier: it grants read (VIEWER) or write
 * (EDITOR) over the node, its CONTAINS subtree and the team's issues on the
 * same repository. Nothing moves, nothing is renumbered.
 */
model WorkShare {
  id          String        @id @default(uuid()) @db.Uuid
  workId      String        @db.Uuid
  work        Issue         @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  user        User          @relation("WorkShareUser", fields: [userId], references: [id], onDelete: Cascade)
  role        WorkShareRole @default(VIEWER)
  createdById String?       @db.Uuid
  createdBy   User?         @relation("WorkShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workId, userId])
  @@index([userId])
}

model WorkLink {
  id        String       @id @default(uuid()) @db.Uuid
  type      WorkLinkType
  fromId    String       @db.Uuid
  from      Issue        @relation("WorkLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String       @db.Uuid
  to        Issue        @relation("WorkLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  actorId   String?      @db.Uuid
  actor     User?        @relation("WorkLinkActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@unique([fromId, toId, type])
  @@index([fromId, type])
  @@index([toId, type])
  @@index([actorId])
}

/// What a deleted work item looked like, so a person can undo the deletion
/// by its original id within the session (INV-840). One row per deleted id;
/// restoring removes it.
model WorkTombstone {
  id          String   @id @db.Uuid
  teamId      String   @db.Uuid
  identifier  String
  snapshot    Json
  deletedById String?  @db.Uuid
  deletedAt   DateTime @default(now())

  @@index([teamId, deletedAt])
}

model WorkAudit {
  id              String     @id @default(uuid()) @db.Uuid
  workId          String     @db.Uuid
  work            Issue      @relation(fields: [workId], references: [id], onDelete: Cascade)
  revision        Int
  actorKind       ActorKind
  actorId         String?    @db.Uuid
  // Restrict, not SetNull: an audit row that loses its actor is the orphan
  // problem this model exists to remove. Deactivate the actor instead.
  actor           User?      @relation("WorkAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  surface         String?
  sessionId       String?
  sourceMessageId String?
  reason          String?
  // Which claim generation the acting execution held, for request events
  // (INV-587). Lets a receipt or a reviewer tie the write to the execution
  // that was entitled to make it, not just to the actor.
  claimGeneration Int?
  before          Json?
  after           Json
  createdAt       DateTime   @default(now())
  receipt         DecisionReceipt?

  @@index([workId, createdAt])
  @@index([actorId])
}

model WorkClaim {
  executionTokenHash String?
  executionId String?
  id         String   @id @default(uuid()) @db.Uuid
  workId     String   @unique @db.Uuid
  work       Issue    @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId    String   @db.Uuid
  actor      User     @relation("WorkClaimActor", fields: [actorId], references: [id], onDelete: Cascade)
  leaseUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       WorkRun[]

  @@index([actorId])
  @@index([leaseUntil])
}

model WorkIdempotency {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  operation String
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorKey  String
  requestHash String
  workId    String?  @db.Uuid
  work      Issue?   @relation(fields: [workId], references: [id], onDelete: SetNull)
  resultId  String?  @db.Uuid
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([teamId, actorKey, operation, key], name: "work_idempotency_scope")
  @@index([teamId])
  @@index([workId])
}

/// Workspace-wide access switches (docs/permissions.md). A single row, id "workspace".
model WorkspaceSettings {
  id                    String   @id
  approvedDomains       String[] @default([])
  defaultTeamIds        String[] @default([])
  membersCanInvite      Boolean  @default(false)
  membersCanCreateTeams Boolean  @default(false)
  updatedAt             DateTime @default(now()) @updatedAt
  updatedById           String?  @db.Uuid
}

model AppSequence {
  name  String @id
  value Int
}

model WorkRun {
  executionRevokedAt DateTime?
  executionTokenHash String?
  executionId String?
  id          String        @id @default(uuid()) @db.Uuid
  publicId    String        @unique
  workId      String        @db.Uuid
  work        Issue         @relation(fields: [workId], references: [id], onDelete: Cascade)
  actorId     String?       @db.Uuid
  actor       User?         @relation("WorkRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  claimId     String?       @db.Uuid
  claim       WorkClaim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  baseRevision Int?
  // Content-addressed semantic contract; legacy runs remain unbound.
  contractRevision String?
  acceptanceDigest String?
  contractSnapshot Json?
  claimSnapshotId String? @db.Uuid
  repository String?
  commitSha String?
  pullRequestNumber Int?
  status      WorkRunStatus @default(RUNNING)
  phase       String?
  summary     String?
  externalUrl String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  // Last write that counted as the executor doing something (INV-996): a
  // run_report, evidence on this run or a comment by its actor.
  lastActivityAt DateTime   @default(now())
  // When the owner was told this run went quiet; cleared when activity resumes.
  staleNotifiedAt DateTime?
  // Full-text vector over summary, kept by a trigger (INV-935).
  searchVector Unsupported("tsvector")?
  evidence    WorkEvidence[]
  reviewDecisions WorkReviewDecision[]
  autoAcceptEvaluations WorkAutoAcceptEvaluation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workId, createdAt])
  @@index([actorId])
  @@index([claimId])
  @@index([status])
  @@index([searchVector], map: "WorkRun_searchVector_idx", type: Gin)
}

model WorkEvidence {
  id        String           @id @default(uuid()) @db.Uuid
  workId    String           @db.Uuid
  work      Issue            @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId     String?          @db.Uuid
  run       WorkRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  actorId   String?          @db.Uuid
  actor     User?            @relation("WorkEvidenceActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      WorkEvidenceKind
  url       String
  summary   String?
  verificationNextAt DateTime?
  verificationLeaseId String? @db.Uuid
  verificationLeaseUntil DateTime?
  verifications EvidenceVerification[]
  createdAt DateTime         @default(now())
  // Retraction (INV-598): evidence is never physically deleted. A wrong link
  // is marked retracted — by whom, when, why, and which work item it should
  // have pointed at — so the mistake and its correction are both on record.
  retractedAt        DateTime?
  retractedById      String?   @db.Uuid
  retractedBy        User?     @relation("WorkEvidenceRetractedBy", fields: [retractedById], references: [id], onDelete: SetNull)
  retractReason      String?
  supersededByWorkId String?   @db.Uuid
  supersededByWork   Issue?    @relation("WorkEvidenceSupersededBy", fields: [supersededByWorkId], references: [id], onDelete: SetNull)

  @@index([verificationNextAt])
  @@index([workId, createdAt])
  @@index([runId])
  @@index([actorId])
}

model WorkReviewDecision {
  id             String                 @id @default(uuid()) @db.Uuid
  workId         String                 @db.Uuid
  work           Issue                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId          String?                @db.Uuid
  run            WorkRun?               @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewerId     String                 @db.Uuid
  reviewer       User                   @relation("WorkReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision       WorkReviewDecisionKind
  reason         String?
  fromRevision   Int
  toRevision     Int
  createdAt      DateTime               @default(now())
  autoAcceptEvaluation WorkAutoAcceptEvaluation?

  @@index([workId, createdAt])
  @@index([runId])
  @@index([reviewerId])
}

enum ContractAmendmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// A change to a committed contract that an agent proposed and a person decides (INV-869).
/// `changes` holds the proposed values of the fields it touches; `before` holds what those
/// fields said when it was proposed, so acceptance can refuse if someone changed them since.
model ContractAmendment {
  id           String                  @id @default(uuid()) @db.Uuid
  workId       String                  @db.Uuid
  work         Issue                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  proposedById String                  @db.Uuid
  proposedBy   User                    @relation("ContractAmendmentProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  baseRevision Int
  changes      Json
  before       Json
  reason       String
  status       ContractAmendmentStatus @default(PENDING)
  decidedById  String?                 @db.Uuid
  decidedBy    User?                   @relation("ContractAmendmentDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime                @default(now())

  @@index([workId, status])
  @@index([proposedById])
}

model WorkAutoAcceptEvaluation {
  id         String            @id @default(uuid()) @db.Uuid
  workId     String            @db.Uuid
  work       Issue             @relation(fields: [workId], references: [id], onDelete: Cascade)
  runId      String?           @db.Uuid
  run        WorkRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  actorId    String?           @db.Uuid
  actor      User?             @relation("WorkAutoAcceptEvaluationActor", fields: [actorId], references: [id], onDelete: SetNull)
  tier       AutoAcceptTier
  outcome    AutoAcceptOutcome
  reasons    String[]
  signals    Json
  decisionId String?           @unique @db.Uuid
  decision   WorkReviewDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([workId, createdAt])
  @@index([runId])
  @@index([tier, outcome])
}

model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  deadLetteredAt DateTime?
  claimedAt   DateTime?
  attempts    Int       @default(0)
  lastError   String?
  deliveries EventOutboxDelivery[]

  @@index([deliveredAt, createdAt])
  @@index([type])
}

model EventOutboxDelivery {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @db.Uuid
  event         EventOutbox @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetHash    String
  attempts      Int         @default(0)
  deliveredAt   DateTime?
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventId, targetHash])
  @@index([deliveredAt, attempts])
  @@index([nextAttemptAt])
}

// Linear-mapped webhook subscriptions: per-endpoint signing secret (shown
// once at create/rotate), optional team scoping (null = all teams), and event
// type filtering (empty = all types). Replaces the single shared
// INVOLUTE_WEBHOOK_URL/SECRET pair, which remains as a legacy fallback while
// no subscription exists.
model WebhookSubscription {
  id                  String   @id @default(uuid()) @db.Uuid
  label               String?
  url                 String
  secret              String
  teamId              String?  @db.Uuid
  team                Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById         String?  @db.Uuid
  createdBy           User?    @relation("WebhookSubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  eventTypes          String[] @default([])
  filterQuery         String?
  enabled             Boolean  @default(true)
  consecutiveFailures Int      @default(0)
  /// Bound to one agent (INV-992): receives only the events written to that
  /// agent's inbox (and its executor dispatches), so a decision wakes it.
  actorId             String?  @db.Uuid
  actor               User?    @relation("WebhookSubscriptionActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([teamId])
  @@index([enabled])
  @@index([actorId])
}

// Kernel notifications: human-gate signals (decision requests, review
// outcomes) projected from outbox events inside the originating transaction.
// sourceEventId ties a row back to its EventOutbox event; the unique
// constraint makes projection exactly-once per event + recipient.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String?   @db.Uuid
  type          String
  workId        String?   @db.Uuid
  work          Issue?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  sourceEventId String?   @db.Uuid
  payload       Json      @default("{}")
  readAt        DateTime?
  // The decision it asked for was made (INV-1093): when, by whom, and how
  // (accepted, rejected, committed…). Set for every recipient at once.
  resolvedAt    DateTime?
  resolvedById  String?   @db.Uuid
  resolution    String?
  emailedAt     DateTime?
  emailAttempts Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([sourceEventId, userId])
  @@index([userId, readAt, createdAt])
  @@index([workId, type])
}

// Phase 2: Idempotent GitHub webhook event log with physical unique constraint
// to eliminate TOCTOU races in duplicate event processing.
model WebhookEventLog {
  id              String   @id @default(uuid()) @db.Uuid
  issueId         String   @db.Uuid
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  eventSourceKey  String
  eventType       String
  payload         Json     @default("{}")
  createdAt       DateTime @default(now())

  @@unique([issueId, eventSourceKey], map: "idx_webhook_event_source")
  @@index([issueId])
  @@index([eventSourceKey])
}

// Phase 3: Persistent watermark cursor for reconciliation sync engine.
model SyncWatermark {
  key       String   @id
  watermark DateTime
  updatedAt DateTime @updatedAt
}

// Who did what on the ops page (INV-796): clearing a sync dead letter,
// replaying an inbound delivery, managing a webhook. No foreign key on the
// actor, so the record outlives the user and never blocks deleting one.
model OpsAudit {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  subject   String
  byActorId String?  @db.Uuid
  reason    String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Phase 3: Dead-letter quarantine for poisoned PR events that repeatedly fail.
model SyncDeadLetter {
  id           String   @id @default(uuid()) @db.Uuid
  repository   String
  itemRef      String
  error        String
  attempts     Int      @default(1)
  lastFailedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([repository, itemRef])
  @@index([repository])
}

// Operator migration receipts survive client disconnects and preserve rollback guards.
model WorkGraphMigration {
  id           String    @id @default(uuid()) @db.Uuid
  planHash     String    @unique
  teamId       String    @db.Uuid
  actorId      String?   @db.Uuid
  reason       String
  status       String    @default("APPLIED")
  plan         Json
  before       Json
  after        Json
  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  @@index([teamId, createdAt])
}

// Signed inbound receipts retain their dedupe keys even after payload retention expires.
enum InboundGitHubStatus {
  PENDING
  PROCESSING
  RETRY
  PROCESSED
  DEAD
}

model InboundGitHubDelivery {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String              @default("github")
  deliveryId      String
  payloadHash     String
  eventType       String
  repository      String
  payload         Json?
  status          InboundGitHubStatus  @default(PENDING)
  attempts        Int                 @default(0)
  failureCount    Int                 @default(0)
  availableAt     DateTime            @default(now())
  leaseOwner      String?
  leaseUntil      DateTime?
  lastErrorCode   String?
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  attemptHistory  InboundGitHubAttempt[]
  replays         InboundGitHubReplay[]

  @@unique([provider, deliveryId])
  @@index([status, availableAt, receivedAt])
  @@index([status, leaseUntil])
}

model InboundGitHubAttempt {
  id          String                @id @default(uuid()) @db.Uuid
  deliveryId  String                @db.Uuid
  delivery    InboundGitHubDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  number      Int
  leaseOwner  String
  outcome     String                @default("PROCESSING")
  errorCode   String?
  startedAt   DateTime              @default(now())
  endedAt     DateTime?

  @@unique([deliveryId, number])
}

model InboundGitHubReplay {
  id                String                @id @default(uuid()) @db.Uuid
  deliveryId        String                @db.Uuid
  delivery          InboundGitHubDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reason            String
  source            String                @default("operator-cli")
  previousAttempts  Int
  requestedAt       DateTime              @default(now())
}


enum EvidenceVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  UNAVAILABLE
  STALE
}

// Only the server verifier appends rows; no GraphQL/MCP mutation exposes writes.
model EvidenceVerification {
  id String @id @default(uuid()) @db.Uuid
  evidenceId String @db.Uuid
  evidence WorkEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifierId String
  verifierVersion String
  status EvidenceVerificationStatus
  repository String?
  commitSha String?
  externalRunId String?
  contractRevision String?
  acceptanceDigest String?
  runId String? @db.Uuid
  observedAt DateTime @default(now())
  resultDigest String
  failureCode String?
  result Json
  createdAt DateTime @default(now())

  @@index([evidenceId, createdAt])
}

// Provider-neutral experiment records. Not evidence verification or work state.
model SemanticAdviceRecord {
  key String @id
  payload Json
  createdAt DateTime @default(now())
}

/// One reminder per bug and kind (INV-750): AT_RISK when 20% of the SLA is
/// left, BREACHED when it is used up. The unique key makes the sweep idempotent.
model BugSlaAlert {
  id        String   @id @default(uuid()) @db.Uuid
  workId    String   @db.Uuid
  work      Issue    @relation(fields: [workId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@unique([workId, kind])
}

// Short-lived, principal-bound continuation state for exhaustive MCP search.
model WorkSearchCursor {
  id        String   @id @default(uuid()) @db.Uuid
  actorKey  String
  queryHash String
  seenIds   String[]
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Versioned external runtime dispatch. Never contains an executable shell command or credential.
model ExecutorDispatch {
  id String @id @default(uuid()) @db.Uuid
  workId String @db.Uuid
  rootId String @db.Uuid
  grantRevision Int
  executorActorId String @db.Uuid
  generation Int @default(1)
  revision Int @default(1)
  state String @default("QUEUED")
  runId String? @db.Uuid
  leaseUntil DateTime?
  checkpoint String?
  feedback String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  effects ExecutorEffect[]
  receipts ExecutorDeliveryReceipt[]
  @@unique([workId, grantRevision])
  @@index([executorActorId, state])
  @@index([rootId])
}

/// An effect intent becomes STARTED once, never automatically retried after an unknown result.
model ExecutorEffect {
  id String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  dispatch ExecutorDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  generation Int
  key String
  action String
  pullRequestNumber Int?
  environment String?
  commitSha String
  paths String[]
  state String @default("PREPARED")
  createdAt DateTime @default(now())
  startedAt DateTime?
  resolution Json?
  @@unique([dispatchId, generation, key])
}

model ExecutorDeliveryReceipt {
  id String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  dispatch ExecutorDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  generation Int
  runId String @db.Uuid
  actorId String @db.Uuid
  idempotencyKey String
  final Boolean @default(true)
  effectId String? @db.Uuid
  payload Json
  createdAt DateTime @default(now())
  @@unique([dispatchId, generation, idempotencyKey])
}
