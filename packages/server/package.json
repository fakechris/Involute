{
  "name": "@turnkeyai/involute-server",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fakechris/Involute"
  },
  "homepage": "https://github.com/fakechris/Involute",
  "bugs": {
    "url": "https://github.com/fakechris/Involute/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./import-pipeline": {
      "types": "./dist/import-pipeline.d.ts",
      "import": "./dist/import-pipeline.js"
    },
    "./semantic-advice": {
      "types": "./dist/semantic-advice.d.ts",
      "import": "./dist/semantic-advice.js"
    }
  },
  "scripts": {
    "admin:bootstrap": "pnpm exec tsx prisma/bootstrap-admin.ts",
    "agent:create": "pnpm exec tsx prisma/agent-credential.ts create",
    "agent:list": "pnpm exec tsx prisma/agent-credential.ts list",
    "agent:revoke": "pnpm exec tsx prisma/agent-credential.ts revoke",
    "agent:deactivate": "pnpm exec tsx prisma/agent-credential.ts deactivate",
    "agent:transfer-owner": "pnpm exec tsx prisma/agent-credential.ts transfer-owner",
    "agent:service": "pnpm exec tsx prisma/agent-credential.ts service",
    "candidates:batch-commit": "pnpm exec tsx prisma/batch-commit.ts",
    "hotfix:reflex": "pnpm exec tsx prisma/hotfix-reflex.ts",
    "repo:migrate": "pnpm exec tsx prisma/repo-migrate.ts",
    "build": "pnpm --filter @turnkeyai/involute-shared build && pnpm run prisma:generate && pnpm exec tsc -p tsconfig.json",
    "prisma:db:push": "pnpm exec prisma db push --skip-generate",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:baseline": "pnpm exec prisma migrate resolve --applied 20260405093000_init",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:reset": "node scripts/safe-migrate-reset.mjs",
    "typecheck": "pnpm --filter @turnkeyai/involute-shared build && pnpm run prisma:generate && pnpm exec tsc -p tsconfig.json --noEmit && pnpm exec tsc -p tsconfig.prisma.json",
    "setup:web-ui-validation": "pnpm exec tsx src/validation-data-setup.ts",
    "setup:son-validation": "pnpm exec tsx src/son-validation-restore.ts",
    "test": "pnpm --filter @turnkeyai/involute-shared build && pnpm run prisma:generate && node scripts/run-vitest.mjs",
    "lint": "pnpm --filter @turnkeyai/involute-shared build && pnpm run prisma:generate && pnpm exec tsc -p tsconfig.json --noEmit && pnpm exec tsc -p tsconfig.prisma.json",
    "graph:migrate": "pnpm exec tsx prisma/graph-migrate.ts",
    "github:inbound": "pnpm exec tsx prisma/github-inbound.ts",
    "evidence:verify": "pnpm exec tsx prisma/evidence-verify.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.29",
    "@prisma/client": "^6.7.0",
    "@turnkeyai/involute-shared": "workspace:*",
    "dotenv": "^16.6.1",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
